SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_ENCRYPTION_KEY=change-this-32-byte-key

# Asaas (URLs base - as keys vão pelo painel de conexão por empresa)
# Sandbox:   https://sandbox.asaas.com/api/v3
# Produção:  https://www.asaas.com/api/v3
ASAAS_SANDBOX_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_PRODUCTION_BASE_URL=https://www.asaas.com/api/v3

# C6 Bank (URLs oficiais - credenciais por empresa no painel de conexão)
C6_SANDBOX_TOKEN_URL=https://apix-sandbox.c6bank.com.br/oauth/v2/token
C6_SANDBOX_PIX_URL=https://apix-sandbox.c6bank.com.br
C6_PRODUCTION_TOKEN_URL=https://apix.c6bank.com.br/oauth/v2/token
C6_PRODUCTION_PIX_URL=https://apix.c6bank.com.br

# Banco Inter (URLs oficiais - credenciais por empresa no painel de conexão)
INTER_SANDBOX_TOKEN_URL=https://cdpj.partners.bancointer.com.br/oauth/v2/token
INTER_SANDBOX_PIX_URL=https://cdpj.partners.bancointer.com.br
INTER_PRODUCTION_TOKEN_URL=https://apis.bancointer.com.br/oauth/v2/token
INTER_PRODUCTION_PIX_URL=https://apis.bancointer.com.br

# Modo de teste (true = mocka pagamentos Asaas, false = usa API real)
MOCK_BANK_MODE=true

# URL da aplicação frontend
VITE_APP_URL=http://localhost:5173
